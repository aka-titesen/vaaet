# ─────────────────────────────────────────────────────────────
# VAAET — Variables de Entorno
# Copiar a .env y completar con valores reales.
# NUNCA versionar el archivo .env en Git.
# ─────────────────────────────────────────────────────────────

# ── Base de Datos PostgreSQL (AWS RDS) — Opcional ──
# El sistema funciona sin base de datos (degradación silenciosa).
DB_HOST=tu-instancia.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vaaet
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# ── Google Colab ──
# En Colab, estas variables se configuran con os.environ en la Celda 2.
# No se necesita archivo .env en Colab.
