# VAAET ML 4.1.0 — plantilla local. Nunca versionar el archivo .env real.
# En Colab, crear estos nombres en el panel Secrets; no usar .env.

# Endpoint compartido (AWS RDS, Neon, Supabase o PostgreSQL propio)
VAAET_DB_HOST=db.example.com
VAAET_DB_PORT=5432
VAAET_DB_NAME=vaaet
VAAET_DB_SSLMODE=verify-full
VAAET_DB_SSLROOTCERT=/absolute/path/to/provider-ca.pem
# Alternativa para Colab Secrets: PEM completo, con saltos de línea escapados.
# VAAET_DB_SSLROOTCERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
VAAET_DB_CONNECT_TIMEOUT=10

# Un usuario distinto por workflow; asignar el group role correspondiente.
VAAET_COLLECTION_DB_USER=vaaet_collection
VAAET_COLLECTION_DB_PASSWORD=replace-me
VAAET_INFERENCE_DB_USER=vaaet_inference
VAAET_INFERENCE_DB_PASSWORD=replace-me
VAAET_TRAINING_DB_USER=vaaet_training
VAAET_TRAINING_DB_PASSWORD=replace-me
VAAET_REVIEW_DB_USER=vaaet_reviewer
VAAET_REVIEW_DB_PASSWORD=replace-me
VAAET_REVIEWER_ID=reviewer-pseudonym

# El perfil administrador no se carga en notebooks. Alembic lo usa localmente o en CI.
VAAET_DATABASE_ADMIN_URL=postgresql+psycopg2://admin:replace-me@db.example.com:5432/vaaet
